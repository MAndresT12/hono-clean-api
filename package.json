{
  "name": "hono-clean-api",
  "version": "1.0.0",
  "description": "Backend base con Hono + TypeScript + Drizzle ORM + SQLite siguiendo Clean Architecture",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "hono",
    "typescript",
    "drizzle",
    "sqlite",
    "clean-architecture"
  ],
  "author": "Milton Heras (MAndresT12)",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@libsql/client": "^0.15.15",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
